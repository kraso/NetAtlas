{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetAtlas",
  "version": "0.1.0",
  "identifier": "org.netatlas.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @netatlas/app dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @netatlas/app build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NetAtlas",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Enciclopedia de hardware de redes (offline)",
    "longDescription": "NetAtlas: grafo de conocimiento técnico navegable sobre hardware de redes, con trazabilidad de fuentes."
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://updates.netatlas.example/latest.json"
      ],
      "pubkey": "REPUESTA-EN-F6-CUANDO-SE-FIRME-ED25519"
    }
  }
}