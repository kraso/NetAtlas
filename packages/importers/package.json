{
  "name": "@netatlas/importers",
  "version": "0.0.0",
  "private": true,
  "description": "NetAtlas — pipeline de importación: parse→normaliza→valida→dedup→reconcilia→persiste con informe de lote",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@netatlas/domain": "workspace:*",
    "@netatlas/data": "workspace:*"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.1.3",
    "@types/node": "^22.10.2",
    "fast-check": "^3.23.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}