{
  "name": "@netatlas/server",
  "version": "0.0.0",
  "private": true,
  "description": "NetAtlas — servidor de sincronización (F8A): API REST + auth OIDC + adaptador PostgreSQL, sin tocar dominio ni vistas (§6.7)",
