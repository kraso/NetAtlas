# Gentleman Guardian Angel Configuration
# https://github.com/your-org/gga
#
# Este fichero SÍ se versiona: los patrones, las reglas (AGENTS.md), el modo
# estricto y el presupuesto son política del repositorio, y así cada clon
# hereda la misma cobertura sin configurar nada. Lo único que cambia por
# máquina es el proveedor: quien prefiera otro lo pasa por entorno
# (`GGA_PROVIDER=claude gga run`), porque este fichero se carga después de la
# config global y la sobrescribe.


# AI Provider (required)
# Options: claude, gemini, codex, opencode, cursor[:model], kilo[:model], kiro, ollama:<model>, lmstudio[:model], github:<model>, minimax[:model]
# Examples:
#   PROVIDER="claude"
#   PROVIDER="gemini"
#   PROVIDER="codex"
#   PROVIDER="ollama:mannix/qwen3.6-27b-a3b-coderx:vision-IQ2_XS"
#   PROVIDER="opencode:anthropic/claude-opus-4-5"
#   PROVIDER="cursor"
#   PROVIDER="cursor:composer-2"
#   PROVIDER="kilo"
#   PROVIDER="kilo:anthropic/claude-sonnet-4-5"
#   PROVIDER="kiro"
#   PROVIDER="ollama:llama3.2"
#   PROVIDER="ollama:codellama"
#   PROVIDER="lmstudio"
#   PROVIDER="lmstudio:qwen2.5-coder-7b-instruct"
#   PROVIDER="github:gpt-4o"
#   PROVIDER="github:deepseek-r1"
#   PROVIDER="minimax"
#   PROVIDER="minimax:MiniMax-M3"
# Proveedor del repo; se cambia por máquina con `GGA_PROVIDER=<proveedor>`.
#
# `opencode` con el modelo del gateway que no se factura por uso: el veredicto
# no depende de que una clave de API tenga saldo, así que el mismo gate puede
# correr en local y en CI (con `codex` la CI necesitaba crédito de OpenAI y sin
# él el job fallaba con «Provider execution failed», sin más pista). El modelo
# va explícito: si el CLI cambia su default, el veredicto cambiaría sin que
# nadie haya tocado el código.
PROVIDER="opencode:opencode/space-bunny-free"

# File patterns to include in review (comma-separated)
# Default: * (all files)
# Examples:
#   FILE_PATTERNS="*.ts,*.tsx"
#   FILE_PATTERNS="*.py"
#   FILE_PATTERNS="*.go,*.mod"
# Los workflows y la configuracion de CI tambien entran al review: son los
# ficheros que deciden si el resto pasa (jobs, presupuestos, rutas, scripts) y
# hasta ahora se commiteaban sin que nadie los mirara — el endurecimiento del
# job de E2E (#22) entro asi, con el gate diciendo «No matching files staged».
#
# Se nombran fichero a fichero en vez de abrir el grifo a `*.json` o a todo
# `*.yaml`: los datasets (`datasets/**/*.json`, cientos de KB generados) y el
# lockfile son contenido generado, no configuracion. `tsconfig*.json` cubre los
# `tsconfig.json` y `tsconfig.build.json` de cada paquete (el `tsc --noEmit`
# que es el lint de la casa) y `.npmrc` la configuracion de instalacion de CI.
FILE_PATTERNS="*.ts,*.tsx,*.js,*.jsx,*.yml,*.yaml,package.json,tsconfig*.json,.npmrc"

# File patterns to exclude from review (comma-separated)
# Default: none
# Examples:
#   EXCLUDE_PATTERNS="*.test.ts,*.spec.ts"
#   EXCLUDE_PATTERNS="*_test.go,*.mock.ts"
# Los archivos de test SÍ se revisan: son la red que valida casi todos los
# movimientos del repositorio y quedaban fuera del gate (`.test.ts`, `.spec.tsx`,
# `apps/app/e2e/*.spec.ts`…). Lo que sigue fuera es el material de apoyo de los
# tests, que no es código de test: fixtures (ficheros `*-fixtures.ts`,
# `*.fixture.ts` y directorios `fixtures/`, `__fixtures__/`) y snapshots
# (`*.snap`, `__snapshots__/`). Del filtro anterior solo se conserva `*.d.ts`
# (declaraciones generadas).
#
# Matching de GGA (v2.10.1), que manda sobre cómo se escriben los patrones: un
# patrón que empieza por `*` se compara como sufijo literal sobre la ruta completa
# (`*.test.ts` → termina en `.test.ts`), y el resto como glob de bash contra la
# ruta completa o el nombre del fichero (donde `*` cruza directorios). Por eso los
# directorios se cubren con `?*fixtures/*` y no con `*fixtures*`: esa segunda
# forma se compararía contra el sufijo literal `fixtures*` y no excluiría nada.
# `pnpm-lock.yaml` lo cubre `*.yaml` y se excluye por nombre: es generado y
# enorme, y su diff no se juzga con las reglas de este repositorio.
EXCLUDE_PATTERNS="*.d.ts,*.snap,*-fixtures.ts,*.fixtures.ts,*-fixture.ts,*.fixture.ts,fixtures/*,?*fixtures/*,?*fixtures__/*,?*__snapshots__/*,*pnpm-lock.yaml"

# File containing code review rules
# Default: AGENTS.md
RULES_FILE="AGENTS.md"

# Strict mode: fail if AI response is ambiguous
# Default: true
STRICT_MODE="true"

# Timeout in seconds for AI provider response
# Default: 300 (5 minutes)
# Increase for large changesets or slow connections
TIMEOUT="900"

# OpenCode provider: optional reasoning effort / variant
# Examples: minimal, low, medium, high, max
# OPENCODE_VARIANT="high"

# OpenCode provider: optional agent profile
# Keep this lightweight. Agent prompts can add significant token overhead.
# OPENCODE_AGENT="gga-reviewer"

# Base branch for --pr-mode (auto-detects main/master/develop if empty)
# Default: auto-detect
# PR_BASE_BRANCH="main"
#
# Aquí se deja vacío a propósito: en local autodetecta (main/master/develop) y en
# CI lo rellena `review.yml` en el config global con la base real del PR. Fijarlo
# en este fichero lo impondría a todos los PRs, y en una pila la base es la rama
# de la unidad padre, no `main`.
