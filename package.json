{
  "name": "netatlas",
  "version": "0.0.0",
  "private": true,
  "description": "NetAtlas — Enciclopedia técnica interactiva y sistema de conocimiento sobre hardware de redes (Fase 0: investigación y arquitectura)",
  "license": "CC-BY-SA-4.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "typecheck": "pnpm -r --filter './packages/**' typecheck",
    "test": "pnpm -r --filter './packages/**' test",
    "lint": "pnpm -r --filter './packages/**' lint",
    "data:lint": "pnpm --filter @netatlas/dataset-tools data:lint",
    "bench": "pnpm --filter @netatlas/datagen bench",
    "migrate": "pnpm --filter @netatlas/data migrate"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}