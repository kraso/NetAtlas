{
  "name": "@netatlas/review-gate",
  "version": "0.0.0",
  "private": true,
  "description": "NetAtlas — gate de review: alcance por hunks (cabecera + líneas cambiadas) y bloqueo solo por hallazgos reproducidos en dos pasadas ciegas, para el hook local y el job de CI",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@netatlas/repo-lint": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "review:gate": "tsx src/gate-cli.ts",
    "gate:install": "tsx src/instalar-cli.ts",
    "corpus": "tsx scripts/corpus.ts",
    "corpus:listar": "tsx scripts/ajustar.ts --listar",
    "corpus:ajustar": "tsx scripts/ajustar.ts",
    "corpus:clasificar": "tsx scripts/ajustar.ts --clasificar"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
